---
// Starlight's footer (previous and next page), with the site's own closing line under it.
import Pagination from 'virtual:starlight/components/Pagination';
---

<footer>
  <Pagination />
  <p class="colophon">
    <span>Myelin 2027.0.0-alpha-2</span>
    <span>Team 5712, Gray Matter</span>
    <a href="/">The path editor</a>
    <a href="https://frc5712.com">The workshop</a>
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule-soft);
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tx3);
  }
  .colophon a {
    color: var(--tx3);
    text-decoration: none;
  }
  .colophon a:hover {
    color: var(--accent);
  }
</style>
