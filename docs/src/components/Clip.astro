---
// A short screen recording from docs/public/clips, looping silently like a GIF but a tenth of the size.
// The recordings are made by the editor's Playwright spec (editor/app/e2e-screens/clip.spec.ts).
interface Props {
  name: string;
  caption: string;
}
const { name, caption } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/clips/${name}.webm`;
---

<figure class="clip not-content">
  <video src={src} autoplay muted loop playsinline controls preload="metadata" aria-label={caption}></video>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .clip {
    margin: 1.8rem 0;
    border: 1px solid var(--rule);
    border-radius: var(--r);
    background: var(--bg2);
    overflow: hidden;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--code-bg);
  }
  figcaption {
    margin: 0;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--rule-soft);
    font-family: var(--__sl-font);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--tx3);
  }
</style>
