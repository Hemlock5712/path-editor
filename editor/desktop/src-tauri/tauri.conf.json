{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myelin",
  "version": "2.0.0",
  "identifier": "com.frc5712.patheditor",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "devUrl": "http://localhost:5712",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Myelin",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#0b0e13",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Myelin: swerve path editor for FRC team 5712",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
