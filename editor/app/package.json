{
  "name": "@team5712/path-editor",
  "version": "2.0.0",
  "private": true,
  "description": "Path editor for team 5712's v2 path follower. All path maths comes from ../core.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:author": "playwright test --config playwright.author.config.ts",
    "e2e:full": "node ../../tools/e2e.mjs",
    "test:nt4": "vitest run --config vitest.nt4.config.ts",
    "screenshots": "playwright test --config playwright.screens.config.ts",
    "e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "lucide-react": "0.469.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
