{
  "framework": "vite",
  "installCommand": "npm ci --prefix editor/core && npm ci --prefix editor/app && npm ci --prefix docs",
  "buildCommand": "npm --prefix editor/app run build && npm --prefix docs run build && node tools/merge-docs.mjs",
  "outputDirectory": "editor/app/dist",
  "rewrites": [
    {
      "source": "/((?!docs(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": false
    }
  ]
}
